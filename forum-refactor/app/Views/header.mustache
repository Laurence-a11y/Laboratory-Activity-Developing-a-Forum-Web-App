<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{#page_title}}{{page_title}} · {{/page_title}}Nested Forum</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="site-header">
    <nav aria-label="Main navigation">
        <a class="brand" href="/">Nested Forum</a>
        <span class="spacer"></span>
        {{#logged_in}}
        <span>Signed in as <strong>{{username}}</strong></span>
        <form action="/logout" method="post" class="inline">
            <input type="hidden" name="csrf" value="{{csrf}}">
            <button type="submit" class="link-button">Log out</button>
        </form>
        {{/logged_in}}
        {{^logged_in}}
        <a href="/login">Log in</a>
        <a href="/register">Register</a>
        {{/logged_in}}
    </nav>
</header>
<main>
{{#flash_success}}<p class="notice success" role="status">{{flash_success}}</p>{{/flash_success}}
{{#flash_error}}<p class="notice error" role="alert">{{flash_error}}</p>{{/flash_error}}
